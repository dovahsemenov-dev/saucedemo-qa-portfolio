{
	"info": {
		"name": "Sauce Demo - Учебная коллекция QA",
		"description": "Интеграционные запросы для проверки бэкенд-логики интернет-магазина (Авторизация, Каталог, Корзина).",
		"schema": "https://getpostman.com"
	},
	"item": [
		{
			"name": "Авторизация - Успешный вход",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\": \"standard_user\",\n    \"password\": \"secret_sauce\"\n}"
				},
				"url": {
					"raw": "https://saucedemo.com"
				},
				"description": "Проверка отправки валидных учетных данных. Ожидаемый ответ: статус 200 OK и авторизационный токен."
			}
		},
		{
			"name": "Каталог - Получение списка товаров",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"url": {
					"raw": "https://saucedemo.com"
				},
				"description": "Запрос на получение всех доступных товаров интернет-магазина. Ожидаемый ответ: статус 200 OK и массив JSON с данными товаров."
			}
		},
		{
			"name": "Корзина - Добавление товара",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"product_id\": 4,\n    \"quantity\": 1\n}"
				},
				"url": {
					"raw": "https://saucedemo.com"
				},
				"description": "Добавление выбранного товара в корзину пользователя по его ID. Ожидаемый ответ: статус 201 Created."
			}
		}
	]
}
